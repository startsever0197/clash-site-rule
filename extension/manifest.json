{
  "manifest_version": 3,
  "name": "Clash 网站规则",
  "version": "1.1.0",
  "description": "将当前网站加入 Clash 直连或代理规则，支持 ClashX Pro 和 Clash for Windows。",
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "添加网站至 Clash 规则"
  },
  "key": ""
}
